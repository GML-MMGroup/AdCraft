      "additionalProperties": false,
      "properties": {
        "max_event_bytes": {
          "default": 65536,
          "maximum": 1048576,
          "minimum": 1,
          "title": "Max Event Bytes",
          "type": "integer"
        },
        "max_handoffs": {
          "default": 8,
          "maximum": 32,
          "minimum": 0,
          "title": "Max Handoffs",
          "type": "integer"
        },
        "max_input_bytes": {
          "default": 131072,
          "maximum": 4194304,
          "minimum": 1,
          "title": "Max Input Bytes",
          "type": "integer"
