          "maximum": 64,
          "minimum": 1,
          "title": "Max Turns",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 120.0,
          "exclusiveMinimum": 0,
          "maximum": 900,
          "title": "Timeout Seconds",
          "type": "number"
        }
      },
      "title": "AgentRunPolicy",
      "type": "object"
    },
    "AgentRunRequest": {
      "additionalProperties": false,
      "properties": {
        "agent_name": {
          "enum": [
            "front_desk",
            "script_writer",
            "product_designer",
            "character_designer",
            "scene_designer",
            "storyboard_artist",
            "video_director",
            "bgm_director",
            "quick_media_agent"
          ],
