        "display_name": {
          "default": "",
          "maxLength": 256,
          "title": "Display Name",
          "type": "string"
        },
        "media_type": {
          "anyOf": [
            {
              "enum": [
                "image",
                "video",
                "audio",
                "text"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Type"
        },
        "semantic_type": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Semantic Type",
          "type": "string"
        },
        "version_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version Id"
        }
      },
      "required": [
        "asset_id",
        "semantic_type"
      ],
      "title": "AgentReferenceSummary",
      "type": "object"
