APP_NAME=AdCraft
APP_VERSION=1.0.0
AGENT_RUNTIME_MODE=real
AGENT_RUNTIME_BASE_URL=http://127.0.0.1:8765
AGENT_RUNTIME_HOST=127.0.0.1
AGENT_RUNTIME_PORT=8765
AGENT_RUNTIME_PYTHON_BASE_URL=http://127.0.0.1:8000
AGENT_RUNTIME_INTERNAL_TOKEN=
AGENT_RUNTIME_PROTOCOL_VERSION=1
AGENT_RUNTIME_CONNECT_TIMEOUT_SECONDS=5
AGENT_RUNTIME_READ_TIMEOUT_SECONDS=30
AGENT_RUNTIME_RUN_TIMEOUT_SECONDS=120
AGENT_RUNTIME_MAX_EVENT_BYTES=65536
AGENT_RUNTIME_MAX_STREAM_BYTES=1048576
V2_PRODUCTION_ACCEPTANCE_ENABLED=false
SKIP_AUDIO_AGENTS=true
LLM_PROVIDER=OpenAI Compatible
LLM_API_KEY=
LLM_BASE_URL=
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
LLM_TRANSIENT_RETRY_DELAY_SECONDS=2
LLM_FRONT_DESK_MODEL=doubao-seed-2-0-mini-260428
LLM_TEAM_MODEL=doubao-seed-2-0-mini-260428
LLM_REQUIREMENTS_MODEL=doubao-seed-2-0-mini-260428
LLM_PRODUCT_DESIGN_MODEL=doubao-seed-2-0-mini-260428
LLM_CREATIVE_MODEL=doubao-seed-2-0-mini-260428
LLM_SCRIPT_MODEL=doubao-seed-2-0-mini-260428
LLM_CHARACTER_MODEL=doubao-seed-2-0-mini-260428
LLM_SCENE_MODEL=doubao-seed-2-0-mini-260428
LLM_STORYBOARD_MODEL=doubao-seed-2-0-mini-260428
LLM_SOUND_EFFECTS_MODEL=doubao-seed-2-0-mini-260428
LLM_VOICEOVER_MODEL=doubao-seed-2-0-mini-260428
LLM_BGM_MODEL=doubao-seed-2-0-mini-260428
LLM_FINAL_VIDEO_MODEL=doubao-seed-2-0-mini-260428
MEDIA_MODE=real
IMAGE_GENERATION_API_KEY=
IMAGE_GENERATION_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/images/generations
IMAGE_GENERATION_MODEL=doubao-seedream-5-0-260128
IMAGE_GENERATION_SIZE=1920x1920
VIDEO_GENERATION_API_KEY=
VIDEO_GENERATION_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/contents/generations/tasks
VIDEO_GENERATION_MODEL=seedance-1-0-pro-fast-251015
VIDEO_GENERATION_RESOLUTION=720p
VIDEO_GENERATION_GENERATE_AUDIO=true
SOUND_EFFECTS_API_KEY=
SOUND_EFFECTS_ENDPOINT=
SOUND_EFFECTS_MODEL=
TTS_API_KEY=
TTS_ENDPOINT=
TTS_MODEL=
BGM_PROVIDER=tianpuyue
BGM_API_KEY=
BGM_ENDPOINT=https://api.tianpuyue.cn
BGM_MODEL=TemPolor i3
BGM_LONG_MODEL=TemPolor i3.5
# auto acquires a no-account callback sink at runtime; manual uses BGM_CALLBACK_BASE_URL.
BGM_CALLBACK_MODE=auto
BGM_CALLBACK_BASE_URL=
# Used only when BGM_PROVIDER=volcengine_ai_music
BGM_ACCESS_KEY_ID=
BGM_SECRET_ACCESS_KEY=
BGM_SUBMIT_ACTION=GenBGMForTime
BGM_API_VERSION=2024-08-12
BGM_GENERATION_VERSION=v5.0
BGM_TIMEOUT_SECONDS=60
COMPOSITION_API_KEY=
COMPOSITION_ENDPOINT=
COMPOSITION_PROVIDER=ffmpeg
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FINAL_COMPOSITION_SUBTITLE_FONT_PATH=
FINAL_COMPOSITION_RENDER_MODE=simple_sequence
FINAL_COMPOSITION_BGM_GAIN_DB_WITH_SOURCE=-18
FINAL_COMPOSITION_BGM_GAIN_DB_WITHOUT_SOURCE=-10
FINAL_COMPOSITION_BGM_FADE_OUT_SECONDS=0.5
FFMPEG_CAPABILITY_TIMEOUT_SECONDS=10
FFMPEG_VIDEO_CODEC=
FFMPEG_ALLOWED_VIDEO_ENCODERS=libx264,libopenh264
MEDIA_DATA_DIR=data
# Temporary backend-first compatibility switch. Enable after the frontend sends
# strong Workflow ETags on every semantic mutation.
V2_REQUIRE_AUTHORING_IF_MATCH=false
