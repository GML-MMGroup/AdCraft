          "type": "string"
        },
        "audit_metadata": {
          "additionalProperties": true,
          "title": "Audit Metadata",
          "type": "object"
        },
        "context": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "bgm_expert": "#/$defs/BgmExpertAgentContext",
                  "character_expert": "#/$defs/CharacterExpertAgentContext",
                  "front_desk_intent": "#/$defs/FrontDeskIntentAgentContext",
                  "intent_contract": "#/$defs/IntentContractAgentContext",
                  "product_expert": "#/$defs/ProductExpertAgentContext",
                  "scene_expert": "#/$defs/SceneExpertAgentContext",
                  "script_writer": "#/$defs/ScriptWriterAgentContext"
                },
                "propertyName": "context_kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/FrontDeskIntentAgentContext"
                },
                {
                  "$ref": "#/$defs/IntentContractAgentContext"
                },
                {
                  "$ref": "#/$defs/ScriptWriterAgentContext"
                },
                {
                  "$ref": "#/$defs/ProductExpertAgentContext"
                },
                {
                  "$ref": "#/$defs/CharacterExpertAgentContext"
                },
                {
                  "$ref": "#/$defs/SceneExpertAgentContext"
                },
                {
                  "$ref": "#/$defs/BgmExpertAgentContext"
                }
              ]
            },
            {
              "$ref": "#/$defs/AgentRunContext"
            }
          ],
          "title": "Context"
        },
        "contract_name": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contract Name"
        },
        "credential_ref": {
          "default": "llm-default",
          "maxLength": 120,
          "minLength": 1,
          "title": "Credential Ref",
          "type": "string"
        },
        "deadline_at": {
          "format": "date-time",
          "title": "Deadline At",
          "type": "string"
        },
        "model_policy_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Model Policy Id",
          "type": "string"
        },
        "operation": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Operation",
          "type": "string"
        },
        "parent_run_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Run Id"
        },
        "policy": {
          "$ref": "#/$defs/AgentRunPolicy"
        },
        "protocol_version": {
          "const": "1",
          "default": "1",
          "title": "Protocol Version",
          "type": "string"
        },
        "request_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "run_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "validation_context": {
          "additionalProperties": true,
          "title": "Validation Context",
          "type": "object"
        },
        "validation_profile": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Validation Profile"
        }
      },
      "required": [
        "run_id",
        "request_id",
        "agent_name",
        "operation",
        "deadline_at",
        "model_policy_id",
        "context"
      ],
